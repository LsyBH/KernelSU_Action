# KernelSU Action -- build profile
#
# Values here are defaults; workflow_dispatch inputs override them per run.
# Only the exact string "true" (or yes/on/1) counts as enabled.

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/LsyBH/android_kernel_oppo_mt6833
KERNEL_SOURCE_BRANCH=oppo/mt6833_s_12.1_oppo_k10_5g

# ⚠️ 注意：请务必在源码仓库的 arch/arm64/configs/vendor/ 目录下确认实际的 defconfig 文件名！
# 这里暂填最常见的 MT6833 配置名，若不对请修改。
KERNEL_CONFIG=vendor/k6833v1_64_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

# Optional: overrides the device label used in artifact names and sets
# CONFIG_LOCALVERSION. Leave blank to derive it from KERNEL_CONFIG.
KERNEL_NAME=OPPO_A55_5G

ADD_LOCALVERSION_TO_FILENAME=false

# Extra flags appended to every make invocation. Values may contain "=".
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# 4.19 内核推荐使用 r450784e，兼容性最佳。
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# 4.x 内核通常不能完全用 LLVM 编译，保持 false
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# 由于内核是 4.19 (非 GKI)，官方 kernelsu 已不支持。
# 使用针对非 GKI 优化的 resukisu 或 kernelsu-next。
# 这里保持默认的 resukisu（专为非 GKI 打造）。
KSU_VARIANT=resukisu
KSU_REF=

# 4.19 内核配合 auto 会自动使用 manual hook，这是最稳妥的
KSU_HOOK_MODE=auto

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# 第一次编译建议关闭 SUSFS，避免补丁冲突导致编译失败。
# 等 KernelSU 编译成功且能开机后，再考虑开启。
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
# ⚠️ 非常重要：4.19 内核没有 path_umount()，必须开启此补丁，否则 KernelSU 可能无法正常卸载挂载点。
ENABLE_PATH_UMOUNT=true

ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
# 强烈建议保持 false，通过 TWRP 刷入 AnyKernel3 zip 包，避免自己提取 boot.img 导致变砖。
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
